# ─── Database ────────────────────────────────────────────────
# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_jwt_secret_here

# ─── AI / Gemini ─────────────────────────────────────────────
# يمكن استخدام مفتاح واحد أو أكثر (حتى 3) للتوزيع التلقائي
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# ─── Telegram (استيراد ملفات المبيعات تلقائياً عبر كروب) ─────
# التوكن من @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# سرّ عشوائي تولّده أنت وتُمرِّره لـ setWebhook (secret_token) — يوثِّق مسار الويب-هوك
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_here

# ─── Server ──────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
